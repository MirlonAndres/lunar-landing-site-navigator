# ==============================================================================
# LUNAR LANDING NAVIGATOR - ENVIRONMENT CONFIGURATION TEMPLATE
# PLANTILLA DE CONFIGURACION DE ENTORNO - LUNAR LANDING NAVIGATOR
# NASA Space Apps Challenge 2026 / Desafio NASA Space Apps 2026
# ==============================================================================

# 1. API Server and Network Bindings / Servidor API y Configuracion de Red
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# 2. Hackathon Cloud IoT Broker (Google Cloud Run - Santiago) / Broker Nube Hackathon
# English: Official hackathon cloud broker credentials for Equipo 01.
# Espanol: Credenciales oficiales del broker en la nube de la hackathon para el Equipo 01.
HACKATHON_EQUIPO_ID=eq01
HACKATHON_DEVICE_TOKEN=YOUR_DEVICE_TOKEN_HERE
HACKATHON_WEB_KEY=YOUR_WEB_KEY_HERE
HACKATHON_WS_URL=wss://fimee-esp32-hub-ahife23fha-tl.a.run.app/ws
HACKATHON_HTTP_BASE=https://fimee-esp32-hub-ahife23fha-tl.a.run.app

# 3. Local Hardware Pin Assignment / Asignacion de Pines de Hardware Local (ESP32-S3)
PIN_DHT22_DATA=4
PIN_SOLAR_PANEL_ADC=1
PIN_SERVO_BASE=13
PIN_SERVO_SHOULDER=14
PIN_SERVO_ELBOW=15
PIN_SERVO_WRIST_PITCH=16
PIN_SERVO_WRIST_ROLL=17

# 4. Teleoperation and WebSocket Relay / Teleoperacion y Retransmision WebSocket
# English: Security token for physical ESP32-S3 microcontroller and dashboard handshake.
# Espanol: Token de seguridad para negociacion de conexion entre el microcontrolador ESP32-S3 y la interfaz.
TELEOP_AUTH_TOKEN=lunar_mission_teleop_token_2026
WEBSOCKET_HEARTBEAT_SEC=30
TELEMETRY_STREAM_HZ=20

# 5. NASA Scientific Dataset Paths / Rutas de Conjuntos de Datos de la NASA
LRO_LOLA_RAW_DEM_PATH=data/raw/Site01_final_adj_5mpp_surf.tif
PROCESSED_DATA_DIR=data/processed

# 4. Artemis Multi-Site Portfolio Coordinates / Coordenadas del Portafolio Multi-Sitio Artemis
# Site 01: Connecting Ridge (Shackleton Rim) - Primary Balanced Site
SITE_01_NAME=Connecting Ridge (Shackleton Rim)
SITE_01_LAT_DEG=-89.444
SITE_01_LON_DEG=222.050

# Site 02: North Peak (Peak near Shackleton) - Contingency & Abort Site
SITE_02_NAME=North Peak (Peak near Shackleton)
SITE_02_LAT_DEG=-89.540
SITE_02_LON_DEG=116.500

# Site 03: Malapert Mountain (Malapert Massif) - High-Elevation DTE Base
SITE_03_NAME=Malapert Mountain (Massif)
SITE_03_LAT_DEG=-85.990
SITE_03_LON_DEG=357.500

# Site 04: Faustini Rim A - Cryogenic PSR Volatiles / Water-Ice Zone
SITE_04_NAME=Faustini Rim A
SITE_04_LAT_DEG=-87.200
SITE_04_LON_DEG=77.000

# Default Selected Site Identifier / Identificador de Sitio Seleccionado por Defecto
DEFAULT_SITE_ID=site_01

# 5. Landing Site Safety Thresholds / Umbrales de Seguridad para Sitio de Alunizaje
# English: Maximum allowable slope angle in degrees for lander stability.
# Espanol: Angulo maximo de pendiente permisible en grados para la estabilidad del modulo.
MAX_SAFE_SLOPE_DEG=15.0

# English: Maximum allowable surface roughness (standard deviation in meters).
# Espanol: Rugosidad superficial maxima permisible (desviacion estandar en metros).
MAX_SAFE_ROUGHNESS_M=0.30
