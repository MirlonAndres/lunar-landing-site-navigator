# ==============================================================================
# LUNAR LANDING NAVIGATOR - GITIGNORE RULES
# NASA Space Apps Challenge 2026 - Team 01 (eq01)
# ==============================================================================

# 1. Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Python Bytecode and Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Environment Variables and Secrets
# Do not commit credentials to version control
.env
.env.*
!.env.example
secrets.h
*secrets.h
firmware/**/secrets.h

# 4. Large Datasets and Media Files Exceeding GitHub Limits (100MB)
data/raw/*
!data/raw/.gitkeep
*.tif
*.tiff
*.geotiff
*.mp4
*.mov
*.avi
*.mkv

# 5. IDE and Editor Configuration Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 6. Embedded Firmware Build Outputs
firmware/**/.pio/
firmware/**/.vscode/
*.bin
*.hex
*.elf
