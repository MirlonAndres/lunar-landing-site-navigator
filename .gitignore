# ==============================================================================
# LUNAR LANDING NAVIGATOR - GITIGNORE RULES
# REGLAS DE EXCLUSION GIT - LUNAR LANDING NAVIGATOR
# NASA Space Apps Challenge 2026 / Desafio NASA Space Apps 2026
# ==============================================================================

# 1. Python Virtual Environments / Entornos Virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Python Bytecode and Build Artifacts / Archivos de Compilacion y Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Environment Variables and Secrets / Variables de Entorno y Claves Secretas
# Do not commit credentials to version control / No subir claves al control de versiones
.env
.env.*
!.env.example
secrets.h
*secrets.h
firmware/**/secrets.h

# 4. Large Datasets and NASA Raw Binaries / Datos Masivos y Binarios Crudos de NASA
# Files exceeding 10MB are excluded from Git / Archivos mayores a 10MB se excluyen de Git
data/raw/*
!data/raw/.gitkeep
data/processed/*.tif
data/processed/*.tiff

# 5. IDEs and Operating System Metadata / Configuracion de IDEs y Sistema Operativo
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 6. Embedded Firmware Build Outputs / Archivos de Compilacion de Microcontroladores
firmware/**/build/
firmware/**/*.hex
firmware/**/*.elf
firmware/**/*.bin
